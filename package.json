{
  "name": "geo-explorer",
  "version": "1.0.0",
  "description": "Geo-Explorer: learning trail explorer with challenges and certificates",
  "main": "index.js",
  "type": "module",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "trail": "node commands/trail.js",
    "challenge": "node commands/challenge.js",
    "certificate": "node commands/certificate.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "mcp:build": "tsc --project mcp-server/tsconfig.json",
    "mcp:start": "node mcp-server/build/index.js"
  },
  "keywords": [
    "learning",
    "trails",
    "challenges",
    "certificates",
    "mcp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
